<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_soem_vendor</name>
  <version>0.4.2</version>
  <description>SOEM (Simple Open EtherCAT Master) as a plain C library</description>

  <license>BSD-3-Clause</license>
  <!-- SOEM, fetched at build time, see its LICENSE -->
  <license>GPL-2.0-only WITH eCos-exception-2.0</license>

  <author email="lnachtigall@duatic.com">Lennart Nachtigall</author>
  <maintainer email="lnachtigall@duatic.com">Lennart Nachtigall</maintainer>

  <buildtool_depend>cmake</buildtool_depend>
  <build_depend>git</build_depend>
  <export>
    <build_type>cmake</build_type>
    <duatic_package_kind>system</duatic_package_kind>
    <duatic_archive_root>public</duatic_archive_root>
    <duatic_publish_source>true</duatic_publish_source>
  </export>

</package>
